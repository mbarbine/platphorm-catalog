{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catalog.local/schemas/capability.catalog.schema.json",
  "title": "Global Capability Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "type",
    "summary",
    "implementations",
    "recommended_source",
    "related_capabilities",
    "reuse_score",
    "maturity_distribution",
    "risk_summary",
    "source_repos",
    "lastUpdatedAt"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)*$" },
    "name": { "type": "string" },
    "type": { "type": "string" },
    "summary": { "type": "string" },
    "implementations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo_id", "repo_name", "maturity", "confidence", "source_paths", "reuse", "risk_count", "test_count"],
        "properties": {
          "repo_id": { "type": "string" },
          "repo_name": { "type": "string" },
          "maturity": { "type": "string" },
          "confidence": { "type": "string" },
          "source_paths": { "type": "array", "items": { "type": "string" } },
          "reuse": { "type": "string" },
          "risk_count": { "type": "integer", "minimum": 0 },
          "test_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "recommended_source": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["repo_id", "score", "reason", "source_paths"],
      "properties": {
        "repo_id": { "type": "string" },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "reason": { "type": "string" },
        "source_paths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "related_capabilities": { "type": "array", "items": { "type": "string" } },
    "reuse_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "maturity_distribution": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "risk_summary": { "type": "string" },
    "source_repos": { "type": "array", "items": { "type": "string" } },
    "lastUpdatedAt": { "type": "string", "format": "date-time" }
  }
}
