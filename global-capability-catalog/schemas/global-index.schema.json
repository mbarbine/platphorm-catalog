{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catalog.local/schemas/global-index.schema.json",
  "title": "Global Capability Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "repositories", "capabilities"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "path", "capability_count", "maturity", "confidence"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "path": { "type": "string" },
          "capability_count": { "type": "integer", "minimum": 0 },
          "maturity": { "type": "string" },
          "confidence": { "type": "string" }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "https://catalog.local/schemas/capability.catalog.schema.json" }
    }
  }
}
