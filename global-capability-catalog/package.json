{
  "name": "global-capability-catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "discover": "tsx scripts/discover-repos.ts",
    "scan": "tsx scripts/scan-repo.ts",
    "analyze": "tsx scripts/analyze-with-codex.ts",
    "validate": "tsx scripts/validate-manifest.ts",
    "validate:all": "tsx scripts/validate-manifest.ts --all",
    "repair": "tsx scripts/repair-manifest.ts",
    "build:index": "tsx scripts/build-index.ts",
    "normalize": "tsx scripts/normalize-capabilities.ts",
    "select:best": "tsx scripts/select-best-implementations.ts",
    "docs": "tsx scripts/generate-docs.ts",
    "catalog:subset": "tsx scripts/catalog-all-repos.ts --limit 3",
    "catalog:all": "tsx scripts/catalog-all-repos.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fast-glob": "^3.3.2",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
